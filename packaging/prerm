#!/bin/sh
set -e
if [ "$1" = remove ] && [ -d /run/systemd/system ]; then
  for unit in vpn-management.service vpn-downloads.service vpn-control.service vpn-control.socket vpn-watchdog.timer vpn-maintenance.timer; do
    systemctl stop "$unit" || true
  done
fi
# Client keys, MFA and configuration survive removal; no engine is purged.
