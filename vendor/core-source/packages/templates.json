{
  "sidebar": "<aside id=\"sidebar\" class=\"sidebar\" aria-label=\"Workspace navigation\">{{brand}}{{navigation}}{{footer}}</aside>",
  "account-menu": "<div id=\"account-menu\" class=\"account-menu\" hidden inert><div class=\"account-identity\">{{identity}}</div>{{actions}}</div>",
  "skeleton": "<div class=\"kn-core-skeleton\" role=\"status\" aria-label=\"Loading content\"><span></span><span></span><span></span></div>",
  "dialog": "<dialog aria-label=\"{{label}}\"><div class=\"kn-core-dialog-content\">{{content}}</div>{{actions}}</dialog>",
  "login-frame": "<main data-core-login data-core-login-product=\"{{product}}\"><section class=\"kn-core-login-card\"><header class=\"kn-core-login-heading\"><p class=\"kn-core-login-product\">{{product}}</p><h1>{{heading}}</h1><p>{{description}}</p></header><div class=\"kn-core-login-content\">{{content}}</div><div class=\"kn-core-login-provider\">{{provider}}</div></section></main>"
}
